From 6b7944fd476eabf9844bd6331a4ebedb393d9289 Mon Sep 17 00:00:00 2001
From: "Isaev, Ilya" <ilya.isaev@intel.com>
Date: Mon, 16 Nov 2026 11:29:19 +0100
Subject: [PATCH] Fix race condition during process shutdown, correct library
 unload order

Signed-off-by: Isaev, Ilya <ilya.isaev@intel.com>
---
 CMakeLists.txt                 | 22 ++++-----
 src/tbb/dynamic_link.cpp       |  4 +-
 src/tbb/main.cpp               | 14 +++++-
 test/CMakeLists.txt            | 23 +++++++++
 test/tbb/test_tbb_shutdown.cpp | 87 ++++++++++++++++++++++++++++++++++
 5 files changed, 136 insertions(+), 14 deletions(-)
 create mode 100644 test/tbb/test_tbb_shutdown.cpp

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5dd801c8..b34dc8d2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -349,6 +349,17 @@ else()
     endif()
 endif()
 
+if (TCM_BUILD)
+  set(TCM_SUBDIR_NAME thread_composability_manager)
+  if (IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${TCM_SUBDIR_NAME}")
+    add_subdirectory(${TCM_SUBDIR_NAME})
+  elseif (TCM_BUILD_OPTION_EXPLICITLY_SET)
+    message(FATAL_ERROR "Build of Thread Composability Manager (TCM) is disabled since "
+                        "${TCM_SUBDIR_NAME} subdirectory does not exist")
+  endif()
+  unset(TCM_SUBDIR_NAME)
+endif()
+
 if (TBB_TEST OR TCM_TEST)
     enable_testing()
 endif()
@@ -417,16 +428,5 @@ if (TBB4PY_BUILD)
     add_subdirectory(python)
 endif()
 
-if (TCM_BUILD)
-  set(TCM_SUBDIR_NAME thread_composability_manager)
-  if (IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${TCM_SUBDIR_NAME}")
-    add_subdirectory(${TCM_SUBDIR_NAME})
-  elseif (TCM_BUILD_OPTION_EXPLICITLY_SET)
-    message(FATAL_ERROR "Build of Thread Composability Manager (TCM) is disabled since "
-                        "${TCM_SUBDIR_NAME} subdirectory does not exist")
-  endif()
-  unset(TCM_SUBDIR_NAME)
-endif()
-
 # Keep it the last instruction.
 add_subdirectory(cmake/post_install)
diff --git a/src/tbb/dynamic_link.cpp b/src/tbb/dynamic_link.cpp
index 868bb96c..cd1f81f9 100644
--- a/src/tbb/dynamic_link.cpp
+++ b/src/tbb/dynamic_link.cpp
@@ -332,8 +332,8 @@ namespace r1 {
 
         void free() {
             const std::size_t size = my_size;
-            for (std::size_t i=0; i<size; ++i)
-                dynamic_unlink( my_handles[i] );
+            for (std::size_t i = size; i > 0; --i)
+                dynamic_unlink( my_handles[i-1] );
         }
     } handles;
 
diff --git a/src/tbb/main.cpp b/src/tbb/main.cpp
index f43c33f5..453f885b 100644
--- a/src/tbb/main.cpp
+++ b/src/tbb/main.cpp
@@ -1,5 +1,6 @@
 /*
     Copyright (c) 2005-2024 Intel Corporation
+    Copyright (c) 2026 UXL Foundation Contributors
 
     Licensed under the Apache License, Version 2.0 (the "License");
     you may not use this file except in compliance with the License.
@@ -68,8 +69,17 @@ extern bool ITT_Present;
 void ITT_DoUnsafeOneTimeInitialization();
 #endif
 
+struct early_library_loader {
+    early_library_loader() {
+        tcm_adaptor::initialize();
+    }
+};
 #if !(_WIN32||_WIN64) || __TBB_SOURCE_DIRECTLY_INCLUDED
 static __TBB_InitOnce __TBB_InitOnceHiddenInstance;
+// Must follow __TBB_InitOnceHiddenInstance: loading libraries registers their global objects destructors,
+// which should be run in reverse order of registration before __TBB_InitOnce's destructor decrements
+// the reference counter and potentially unloads the library.
+static early_library_loader __early_library_loader_instance;
 #endif
 
 //------------------------------------------------------------------------
@@ -79,7 +89,6 @@ static __TBB_InitOnce __TBB_InitOnceHiddenInstance;
 void __TBB_InitOnce::add_ref() {
     if (++count == 1) {
         governor::acquire_resources();
-        tcm_adaptor::initialize();
     }
 }
 
@@ -133,6 +142,9 @@ extern "C" bool WINAPI DllMain( HANDLE /*hinstDLL*/, DWORD reason, LPVOID lpvRes
     switch( reason ) {
         case DLL_PROCESS_ATTACH:
             __TBB_InitOnce::add_ref();
+            // TODO: loading libraries inside DllMain is not recommended because of potential issues with loader lock.
+            // Consider moving it out of DllMain.
+            tcm_adaptor::initialize();
             break;
         case DLL_PROCESS_DETACH:
             // Since THREAD_DETACH is not called for the main thread, call auto-termination
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index ee2628c9..7cb29492 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -473,6 +473,7 @@ if (TARGET TBB::tbb)
     if (APPLE OR ANDROID_PLATFORM)
         target_link_libraries(test_dynamic_link PRIVATE -rdynamic)
     endif()
+
     if (WIN32 AND NOT TBB_TCM_TESTING)
         tbb_add_test(SUBDIR tbb NAME test_numa_dist DEPENDENCIES TBB::tbb)
     endif()
@@ -583,6 +584,28 @@ if (TARGET TBB::tbb)
         tbb_add_tbbbind_test(SUBDIR tbb NAME test_tbbbind)
     endif()
 
+    # Test for the library shutdown during process termination
+    if (BUILD_SHARED_LIBS AND NOT TBB_EMSCRIPTEN)
+        tbb_add_lib_test(SUBDIR tbb NAME test_tbb_shutdown DEPENDENCIES TBB::tbb)
+        tbb_add_test(SUBDIR tbb NAME test_tbb_shutdown)
+        target_include_directories(test_tbb_shutdown PRIVATE
+            $<TARGET_PROPERTY:TBB::tbb,INTERFACE_INCLUDE_DIRECTORIES>)
+        set_target_properties(test_tbb_shutdown PROPERTIES
+            BUILD_RPATH_USE_ORIGIN TRUE
+            BUILD_RPATH "$ORIGIN")
+        target_compile_definitions(test_tbb_shutdown PRIVATE
+            "TEST_TBB_SHUTDOWN_LIBRARY=\"$<TARGET_FILE_NAME:_test_tbb_shutdown>\"")
+
+        add_dependencies(test_tbb_shutdown _test_tbb_shutdown)
+        # Optional libraries loaded at run-time; build them if available
+        foreach(_shutdown_dep TCM::tcm TBB::tbbmalloc TBB::tbbbind TBB::tbbbind_2_0 TBB::tbbbind_2_5)
+            if (TARGET ${_shutdown_dep})
+                add_dependencies(test_tbb_shutdown ${_shutdown_dep})
+            endif()
+        endforeach()
+        unset(_shutdown_dep)
+    endif()
+
     if ((NOT "${CMAKE_SYSTEM_PROCESSOR}" MATCHES "mips") AND (NOT TBB_EMSCRIPTEN))
         # TODO: Fix for MIPS
         tbb_add_test(SUBDIR tbb NAME test_tbb_fork DEPENDENCIES TBB::tbb)
